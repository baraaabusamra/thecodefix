# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (real secrets never committed; the .example template is safe
# and SHOULD be committed — it's the only setup documentation for env vars)
.env*
!.env.example

# service-account keys (Google Indexing API) — never commit these
*service-account*.json
*-key.json
gcp-*.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# local reference (W3Schools style sample)
w3school/

# local reference books (copyrighted source material — never commit)
books/

# logo source (used copy lives in public/)
logo/

# one-off debug/scratch artifacts (not source)
pilot_report.json
scratch_*.txt

# Ruflo local secrets and runtime data
.env
.env.local
.env.*.local
.claude-flow/data/
.claude-flow/logs/
.claude-flow/sessions/
