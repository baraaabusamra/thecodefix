# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (real secrets never committed; the .example template is safe
# and SHOULD be committed — it's the only setup documentation for env vars)
.env*
!.env.example

# service-account keys (Google Indexing API) — never commit these
*service-account*.json
*-key.json
gcp-*.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# local reference (W3Schools style sample)
w3school/

# local reference books (copyrighted source material — never commit)
books/

# logo source (used copy lives in public/)
logo/

# one-off debug/scratch artifacts (not source)
pilot_report.json
scratch_*.txt

# Ruflo local secrets and runtime data
.env
.env.local
.env.*.local
.claude-flow/data/
.claude-flow/logs/
.claude-flow/sessions/

# Claude Code agent worktrees (transient, per-session)
.claude/worktrees/

# AI/ML lesson dataset caches (downloaded by torchvision at runtime).
# Narrow patterns only — match the directories created by the AI/ML
# project's MNIST / FashionMNIST / CIFAR-10 download step. If a future
# lesson adds a new dataset, extend these lines rather than using /data/.
/data/MNIST/
/data/FashionMNIST/
/data/cifar-10-batches-py/
/data/CIFAR-10/
/data/CIFAR-100/

# wave-local Python validation scripts (development only, not shipped in repo)
/scripts/_wave*_local_validate.py
/scripts/_wave*-local-only.txt

# local MDX safety helpers (development only)
/scripts/_mdx-local_*.py

# project map / audit outputs (regenerate: node scripts/audit/run-all.mjs)
/audit-out/
/docs/project-map/map-data.js

# V2 monorepo build outputs
**/.next/
**/next-env.d.ts
.turbo/
**/.turbo/
