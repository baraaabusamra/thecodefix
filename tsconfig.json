{
  // Whole-repository type check (`npm run typecheck`): the web app, every
  // foundation package and every feature module in one program, so a broken
  // contract between packages fails here before any build.
  // The test runner (tsx) also reads this file for the "@/" alias.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "node_modules/.cache/tsconfig.tsbuildinfo",
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./apps/web/src/*"]
    }
  },
  "include": [
    "apps/web/next-env.d.ts",
    "apps/web/**/*.ts",
    "apps/web/**/*.tsx",
    "apps/web/.next/types/**/*.ts",
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx",
    "packages/*/*.ts",
    "modules/*/src/**/*.ts",
    "modules/*/src/**/*.tsx",
    "scripts/**/*.ts"
  ],
  "exclude": ["node_modules", "**/node_modules", "archive", "content", "**/.next"]
}
