# ── Site ─────────────────────────────────────────────────────────────
# Public site URL — canonical URLs, sitemap, robots, OpenGraph.
NEXT_PUBLIC_SITE_URL=https://ar.thecodefix.com

# ── Database (Neon Postgres) — optional, dormant until set ────────────
# Provision via Vercel Marketplace (Storage → Neon) or neon.tech, then paste
# the pooled connection string here. Enables persisted users, RBAC, logs.
# After setting: `npm run db:generate` then `npm run db:migrate`.
DATABASE_URL=
# Unpooled (direct) connection string — drizzle-kit migrate/push use this
# instead of DATABASE_URL because migrations over a pgBouncer-pooled
# connection are unreliable. Neon gives you both from the same project.
DATABASE_URL_UNPOOLED=

# ── Auth (Auth.js / NextAuth) — optional, dormant until set ───────────
# Generate a secret: npx auth secret
AUTH_SECRET=
# GitHub OAuth app (https://github.com/settings/developers)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Google OAuth client (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── Admin dashboard (/admin) — optional, open until set ──────────────
# Access key for the admin overview page. When set, /admin requires this
# key and a gear link appears in the header. Generate: openssl rand -hex 16
ADMIN_TOKEN=

# ── Payments (Stripe) — optional, dormant until set ──────────────────
STRIPE_SECRET_KEY=
# Price ID of the Pro subscription product
STRIPE_PRO_PRICE_ID=
# Webhook signing secret (from the Stripe webhook you create)
STRIPE_WEBHOOK_SECRET=

# Jooble job aggregator API key — request free at https://jooble.org/api/about
JOOBLE_API_KEY=

# ── Google Analytics (GA4) — optional, dormant until set ──────────────
# Measurement ID from admin.google.com/analytics (starts with G-).
NEXT_PUBLIC_GA_ID=

# ── Production error alerts — optional but required to close Phase 0 ─────
# Server-only Slack/Discord/custom webhook. Errors are redacted and repeated
# signatures are throttled before delivery. Never expose this as NEXT_PUBLIC_*.
ERROR_ALERT_WEBHOOK_URL=
# Optional bearer token for a custom webhook receiver (not needed for Slack).
ERROR_ALERT_WEBHOOK_TOKEN=

# ── Curriculum extraction pipeline (src/lib/curriculum/) — optional ───
# Discovers + extracts real university curricula for the academic explorer.
# Dormant per-provider: discovery needs Tavily, extraction needs Gemini
# and/or Anthropic (only one extraction provider is required).
TAVILY_API_KEY=
GEMINI_API_KEY=
# Fail-closed master switch for paid AI extraction. Provider keys alone do
# not enable it. Keep false while no human review/publish path exists.
CURRICULUM_EXTRACTION_ENABLED=false
# Model id to use for extraction, e.g. gemini-flash-lite-latest
GEMINI_EXTRACTION_MODEL=
ANTHROPIC_API_KEY=
# Model name recorded on each extraction run for bookkeeping (defaults to
# a Claude model id in code — a legacy default from before Gemini became
# the primary extractor). Cosmetic only; doesn't select which provider runs.
CURRICULUM_EXTRACTION_MODEL=

# ── Instructor payout encryption (scripts/encrypt-instructor-payout.mjs) ─
# 32 bytes, base64-encoded (e.g. `openssl rand -base64 32`). Optional —
# only needed to run that script.
ENCRYPTION_KEY=

# ── Google Indexing API (scripts/notify-index.mjs) — optional ─────────
# Service-account JSON key with Owner access on the Search Console
# property. Provide ONE of the two — see docs/search-indexing-api.md.
GOOGLE_INDEXING_KEY_FILE=
GOOGLE_INDEXING_KEY=
