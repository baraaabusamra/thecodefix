{
  "name": "thecodefix",
  "version": "0.1.0",
  "private": true,
  "description": "The Code Fix V2 — Arabic-first technology education platform (monorepo)",
  "packageManager": "npm@10.9.4",
  "workspaces": [
    "apps/*",
    "packages/*",
    "modules/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=@tcf/web",
    "build": "turbo run build --filter=@tcf/web",
    "build:offline": "NEXT_FONT_GOOGLE_MOCKED_RESPONSES=$PWD/scripts/ci/google-fonts-mock.cjs npm run build -w @tcf/web -- --webpack",
    "start": "npm run start -w @tcf/web",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "check:all": "node scripts/run-checks.mjs",
    "ci": "npm run typecheck && npm run lint && npm test && npm run check:all && npm run build",
    "map": "node scripts/audit/run-all.mjs",
    "map:branches": "node scripts/audit/run-all.mjs --branches",
    "workspaces:sync": "node scripts/v2/workspaces.mjs",
    "port-branch": "node scripts/v2/port-branch.mjs",
    "db:generate": "drizzle-kit generate --config packages/db/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config packages/db/drizzle.config.ts",
    "db:migrate:http": "node scripts/migrate-http.mjs",
    "db:migrate:deploy": "node scripts/db-migrate.mjs",
    "db:verify": "node scripts/check-migrations.mjs --db",
    "db:lock-migrations": "node scripts/check-migrations.mjs --update-lock",
    "check:migrations": "node scripts/check-migrations.mjs",
    "db:push": "drizzle-kit push --config packages/db/drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config packages/db/drizzle.config.ts",
    "make-owner": "node scripts/make-owner.mjs",
    "notify-index": "node scripts/notify-index.mjs",
    "dates:generate": "node scripts/generate-lesson-dates.mjs",
    "check:links": "node scripts/link-check.mjs",
    "check:summary-order": "node scripts/check-summary-order.mjs",
    "check:frontmatter": "node scripts/check-frontmatter.mjs",
    "check:blog-ref": "node scripts/check-blog-ref-frontmatter.mjs",
    "check:redundant-h1": "node scripts/check-redundant-h1.mjs",
    "check:ref-related": "node scripts/check-ref-related.mjs",
    "check:ref-keywords": "node scripts/check-ref-keyword-overlap.mjs",
    "check:quizzes": "node scripts/check-quizzes.mjs",
    "check:quiz-bank": "node scripts/check-quiz-bank.mjs",
    "check:roadmaps": "node scripts/check-roadmaps.mjs",
    "check:academic": "node scripts/check-academic.mjs",
    "check:academic-courses": "node scripts/check-academic-courses.mjs",
    "check:orphan-blog": "node scripts/check-orphan-blog.mjs",
    "seo:title-audit": "node scripts/seo-audit-titles.mjs",
    "verify:python-sandbox": "node scripts/verify-python-sandbox.mjs",
    "set-role": "node scripts/set-role.mjs",
    "encrypt-instructor-payout": "node scripts/encrypt-instructor-payout.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@auth/drizzle-adapter": "^1.11.2",
    "@google/genai": "^2.17.1",
    "@monaco-editor/react": "^4.7.0",
    "@neondatabase/serverless": "^1.1.0",
    "@next/third-parties": "^16.3.0",
    "@tavily/core": "^0.7.7",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.8.0",
    "@vercel/speed-insights": "^2.0.0",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.45.2",
    "flag-icons": "^7.5.0",
    "gray-matter": "^4.0.3",
    "next": "16.3.8",
    "next-auth": "^5.0.0-beta.31",
    "next-mdx-remote": "^6.0.0",
    "pdf-parse": "^2.4.5",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "rehype-highlight": "^7.0.2",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "stripe": "^22.2.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^20",
    "@types/pdf-parse": "^1.1.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "png-to-ico": "^3.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "turbo": "^2.11.8",
    "typescript": "^5"
  },
  "browserslist": [
    "last 2 years",
    "not dead",
    "not op_mini all"
  ]
}
